# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── EnergyPlus ────────────────────────────────────────────────────────────────
# Windows example: C:/EnergyPlusV26-2-0
# Linux example:   /usr/local/EnergyPlus-26-2-0
ENERGYPLUS_DIR=
ENERGYPLUS_IDD=

# ── Runtime paths ─────────────────────────────────────────────────────────────
DB_PATH=./data/smartair.db
RUNS_DIR=./runs

# ── Building location ─────────────────────────────────────────────────────────
LAT=28.6139
LON=77.2090
TIMEZONE=Asia/Kolkata

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_KEY=

# ── Forecast source ───────────────────────────────────────────────────────────
# "live"    — fetch from Open-Meteo at runtime (requires internet)
# "fixture" — read a frozen JSON from FIXTURE_PATH (for testing / demo)
FORECAST_SOURCE=live
FIXTURE_PATH=./data/fixtures

# ── Pipeline timeouts ─────────────────────────────────────────────────────────
SIM_TIMEOUT_S=300
PIPELINE_TIMEOUT_S=900
